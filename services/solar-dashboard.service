[Unit]
Description=Solar Tracker Web Dashboard
Documentation=https://github.com/your-repo/solar-tracker
After=network.target solar-monitor.service

[Service]
Type=simple
User=techenergy3
WorkingDirectory=/home/techenergy3/solar
ExecStart=/home/techenergy3/solar/venv/bin/python -m solar_tracker.web_dashboard
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
